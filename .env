# Database
DATABASE_URL="postgresql://jarvis:jarvis_password@localhost:5432/jarvis?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET="jarvis-super-secret-jwt-key-development-only"
JWT_EXPIRES_IN="7d"

# OpenAI (for AI features)
OPENAI_API_KEY=""

# Meta (for Ads Manager)
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""

# WhatsApp (for Lead Management)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Email (for Email Automation)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""

# Application
NODE_ENV="development"
PORT="3000"

# Security
BCRYPT_ROUNDS="10"

# Rate Limiting
THROTTLE_TTL="60"
THROTTLE_LIMIT="100"

# Sandbox
SANDBOX_BUDGET_LIMIT="1000.00"
SANDBOX_ENABLED="true"
