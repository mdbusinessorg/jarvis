# Database
DATABASE_URL="postgresql://jarvis:jarvis_password@localhost:5432/jarvis?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# OpenAI (for AI features)
OPENAI_API_KEY="your-openai-api-key"

# Meta (for Ads Manager)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_ACCESS_TOKEN="your-meta-access-token"

# WhatsApp (for Lead Management)
WHATSAPP_API_KEY="your-whatsapp-api-key"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"

# Email (for Email Automation)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-email-password"

# Voice (for Voice Commands)
OPENAI_WHISPER_API_KEY="your-openai-whisper-api-key"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
GOOGLE_TTS_API_KEY="your-google-tts-api-key"

# Application
NODE_ENV="development"
PORT="3000"

# Security
BCRYPT_ROUNDS="10"

# Rate Limiting
THROTTLE_TTL="60"
THROTTLE_LIMIT="100"

# Sandbox
SANDBOX_BUDGET_LIMIT="1000.00"
SANDBOX_ENABLED="true"
